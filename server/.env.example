# Monolithic Server Environment Configuration
NODE_ENV=development
PORT=7000
# Application name
APP_NAME="Multi-Branch Pharmacy Inventory"

# Backend server base URL
APP_URL=http://localhost:7000

# Backend REST API base URL
API_URL=http://localhost:7000/api

# Frontend application URL
FRONTEND_URL=http://localhost:5173



# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=multi_branch_pharmacy
DB_USERNAME=postgres
DB_PASSWORD=AEHJSS36

# Store Timezone
STORE_TIMEZONE=Africa/Addis_Ababa

# ---- Sessions & Auth ----
# A long random value, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRE_MINUTES=60
TOKEN_EXPIRATION_MINUTES=10080
SESSION_IDLE_MINUTES=15
SESSION_TIMEOUT_MINUTES=15
IP_LOCATION_LOOKUP=true
# Proxies allowed to pass the visitor's real IP (X-Forwarded-For): "loopback", a hop count like 1, or a list of IPs/subnets
TRUSTED_PROXIES=loopback
DEVICE_LOCATION=true
INVITATION_EXPIRE_MINUTES=10

# ---- Mail ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=amirsiraj1995@gmail.com
MAIL_PASSWORD=acpabuliwxhlmjnh
MAIL_FROM_ADDRESS=amirsiraj1995@gmail.com
MAIL_FROM_NAME="Multi-Branch Pharmacy Inventory"

# ---- AI Assistance (Google Gemini) ----
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.5-flash works on the free tier; Pro models (e.g. gemini-3.1-pro-preview) need billing turned on
GEMINI_MODEL=gemini-3.5-flash
# A lighter model that answers when the main one is overloaded (none = off)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=90

